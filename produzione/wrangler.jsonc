// Configurazione Cloudflare di DigiHome — VERSIONE DEFINITIVA (dati veri).
// È separata da quella di prova (wrangler.jsonc nella cartella principale):
// altro Worker, altro database, niente dati di prova.
// In Workers Builds questo Worker usa "Root directory" = produzione e il ramo GitHub "produzione".
// I valori riservati (ACCESS_TEAM_DOMAIN, ACCESS_AUD, BOOTSTRAP_ADMIN_EMAIL) si impostano come Secret nel pannello.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "digihome",
  "main": "../src/worker.js",
  "compatibility_date": "2025-09-01",

  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digihome",
      "database_id": "ecc769f4-efa7-4f87-9375-b72fdf7c825a",
      "migrations_dir": "../migrations"
    }
  ],

  "vars": {
    "APP_ENV": "produzione",
    // Mai dati di prova nella versione definitiva: il pulsante "Carica dati di prova" non esiste qui.
    "ALLOW_DEMO": "false",
    // Indirizzo del calendario pubblico (cartella calendario/): serve a mostrare il link da dare ad Airbnb e Booking.
    "CALENDAR_PUBLIC_URL": "https://digihome-calendario.mattia-digirolamo03.workers.dev"
  },
  "keep_vars": true,

  // Aggiornamento automatico dei calendari di Airbnb e Booking: ogni 30 minuti.
  "triggers": { "crons": ["*/30 * * * *"] },

  "observability": { "enabled": true }
}
