// Configurazione Cloudflare del gestionale (ambiente di prova, dati inventati).
// I valori riservati (ACCESS_TEAM_DOMAIN, ACCESS_AUD, BOOTSTRAP_ADMIN_EMAIL) NON stanno qui:
// si impostano come "segreti" nel pannello Cloudflare, così non finiscono nel codice.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gestionale-case-prova",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Nessun indirizzo pubblico automatico: il gestionale si apre solo dal dominio protetto da Access.
  "workers_dev": false,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Ogni richiesta passa dal Worker, che aggiunge le intestazioni di sicurezza.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gestionale-prova",
      "database_id": "DA_COMPILARE_DOPO_LA_CREAZIONE",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "APP_ENV": "prova",
    "ALLOW_DEMO": "true"
  },

  "observability": { "enabled": true }
}
