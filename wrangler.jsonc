// Configurazione Cloudflare di DigiHome (ambiente di prova, dati inventati).
// I valori riservati (ACCESS_TEAM_DOMAIN, ACCESS_AUD, BOOTSTRAP_ADMIN_EMAIL) NON stanno qui:
// si impostano come "segreti" nel pannello Cloudflare, così non finiscono nel codice.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "digihome-prova",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",

  // Beta: indirizzo gratuito *.workers.dev, protetto da Cloudflare Access (attivato dal pannello).
  // Nessun indirizzo di anteprima: ogni versione ha un solo indirizzo, quello protetto.
  "workers_dev": true,
  "preview_urls": false,

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Ogni richiesta passa dal Worker, che aggiunge le intestazioni di sicurezza.
    "run_worker_first": true
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "digihome-prova",
      "database_id": "c9d67f09-e198-4f66-abfb-97211cfa0d41",
      "migrations_dir": "migrations"
    }
  ],

  "vars": {
    "APP_ENV": "prova",
    "ALLOW_DEMO": "true"
  },
  // Le variabili impostate nel pannello Cloudflare (es. ACCESS_TEAM_DOMAIN, ACCESS_AUD) restano
  // anche dopo ogni pubblicazione da GitHub, anche se salvate come "Text" invece che "Secret".
  "keep_vars": true,

  // Aggiornamento automatico dei calendari di Airbnb e Booking: ogni 30 minuti.
  "triggers": { "crons": ["*/30 * * * *"] },

  "observability": { "enabled": true }
}
